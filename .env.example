# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# DEMO / MOCK MODE (Allows testing without paid external API keys)
DEMO_MODE=true

# AI PROVIDER (e.g., gemini, openai, mock)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# MAPS & ROUTING (Optional overrides; falls back to free Leaflet/OSM/OSRM by default)
MAPS_API_KEY=
DATABASE_URL="postgresql://postgres:password@localhost:5432/smart_travel_db"
