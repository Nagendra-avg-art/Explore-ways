# SERVER CONFIGURATION (Required)
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# DATA MODE (Required)
# Set to 'false' for live real-world places, photos, and dining. Set to 'true' only for test mocks.
DEMO_MODE=false

# AI PROVIDER (Optional — Defaults to 100% free grounded local engine)
# If GEMINI_API_KEY is not provided, the server automatically uses the built-in grounded engine.
AI_PROVIDER=grounded-local-engine
GEMINI_API_KEY=

# WEATHER SERVICE (Optional — Defaults to free Open-Meteo API, zero API key needed)
WEATHER_PROVIDER=open-meteo

